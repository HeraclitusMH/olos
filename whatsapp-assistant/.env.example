POSTGRES_USER=assistant
POSTGRES_PASSWORD=changeme
POSTGRES_DB=assistant_db
DATABASE_URL=postgresql+asyncpg://assistant:changeme@db:5432/assistant_db

OPENAI_API_KEY=sk-...

WHATSAPP_VERIFY_TOKEN=your-verify-token-here
WHATSAPP_ACCESS_TOKEN=your-meta-access-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
META_APP_SECRET=your-meta-app-secret

GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://yourdomain.com/oauth/google/callback

ENCRYPTION_KEY=generate-a-fernet-key

DAILY_API_LIMIT=100
DEFAULT_TIMEZONE=Europe/Madrid

# Daily agenda scheduler (per-user prefs override these defaults).
DAILY_AGENDA_DEFAULT_TIMEZONE=Asia/Makassar
DAILY_AGENDA_DEFAULT_TIME_LOCAL=08:00
DAILY_AGENDA_TICK_SECONDS=60
DAILY_AGENDA_SEND_WINDOW_MINUTES=5

# Backups (used by scripts/backup.sh and scripts/restore.sh, not by the app).
# Configure rclone remote interactively with: rclone config
B2_BUCKET=whatsapp-assistant-backups
